print("Books with 1 page:", (df_clean["num_pages"] == 1).sum())
print("Books with 2 pages:", (df_clean["num_pages"] == 2).sum())

small_page_books[["bookID", "title", "num_pages", "publisher"]]

#Several records with 1-2 pages appear to be audiobooks


#Checking zero value ratings
df_clean[df_clean["average_rating"] == 0][["bookID", "title", "average_rating", "ratings_count"]]


#All books with 0 rating average also have 0 ratings, which means it shouldn't count for the average.
df_clean["average_rating"] = df_clean["average_rating"].replace(0, float("nan"))
df_clean["average_rating"].isna().sum()


# Check for negative rating counts
(df_clean["ratings_count"] < 0).sum()


# Count records with negative review counts
(df_clean["text_reviews_count"] < 0).sum()


