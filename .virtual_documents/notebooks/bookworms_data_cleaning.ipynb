import pandas as pd
url = "../data/raw/books.csv"
# df = pd.read_csv(url)
# ParserError: Error tokenizing data. C error: Expected 12 fields in line 3350, saw 13


#showing the table without the faulty line
df_preview = pd.read_csv(url, dtype=str, nrows=3348)


df_preview.columns


df_preview.tail()


#showing only the faulty line to understand the issue
problem_row = pd.read_csv(url, skiprows=3349, header=None, nrows=1, dtype=str)

problem_row.T #.T shows the line vertically

# The CSV could not be loaded because line 3350 contained 13 fields instead of 12.
# After inspecting this row, we found that a comma within the author name split the authors field into two columns.


#function to fix the issue with line 3350
def fix_author(row):
    author = row[2] + "," + row[3]
    corrected_row = row[:2] + [author] + row[4:]
    return corrected_row

#checking if the function works as intended
example = problem_row.iloc[0].tolist()
print("Row before fixing:")
print(example)
print("length:", len(example))

fixed_example = fix_author(example)
print("\nRow after fixing:")
print(fixed_example)
print("length:", len(fixed_example))


#Collect rows with extra fields
def collect_bad_rows(row):
    bad_rows.append(row)
    return None


# Reset the list before collecting to avoid duplicate entries
bad_rows = []

df_check = pd.read_csv(url, dtype=str, engine="python", on_bad_lines=collect_bad_rows)
print("Rows with extra fields:", len(bad_rows))


pd.DataFrame(bad_rows).T


# Correct each malformed row using our tested function
fixed_rows = []

for row in bad_rows:
    fixed_rows.append(fix_author(row))

fixed_books = pd.DataFrame(fixed_rows,columns=df_check.columns)

df_clean = pd.concat([df_check, fixed_books], ignore_index=True)

print("Before adding corrected rows:", df_check.shape)
print("After adding corrected rows:", df_clean.shape)


#Starting to clean the columns
df_clean.columns.tolist()


#Removing blank spaces
df_clean.columns = df_clean.columns.str.strip()
df_clean.columns.tolist()


# Count missing values in each column
df_clean.isna().sum()
# No missing values were detected in the loaded data.


print("Duplicated rows? -", df_clean.duplicated().sum())
# No fully duplicated rows were found.
print("\nDuplicated book IDs? -", df_clean["bookID"].duplicated().sum())
# No duplicate book IDs were found.


df_clean.info()


# Convert whole-number columns to integers
df_clean["bookID"] = df_clean["bookID"].astype(int)
df_clean["num_pages"] = df_clean["num_pages"].astype(int)
df_clean["ratings_count"] = df_clean["ratings_count"].astype(int)
df_clean["text_reviews_count"] = df_clean["text_reviews_count"].astype(int)

# Ratings can contain decimal places
df_clean["average_rating"] = df_clean["average_rating"].astype(float)


df_clean.dtypes


df_clean[["average_rating", "num_pages", "ratings_count", "text_reviews_count"]].describe().round(2)


#Checking how many zero values there are
print("Zero page counts:", (df_clean["num_pages"] == 0).sum())
print("Zero average ratings:", (df_clean["average_rating"] == 0).sum())
print("Zero rating counts:", (df_clean["ratings_count"] == 0).sum())
print("Zero review counts:", (df_clean["text_reviews_count"] == 0).sum())


# Inspect books with a page count of zero, showing only a few columns
df_clean[df_clean["num_pages"] == 0][["bookID", "title", "authors", "num_pages", "publisher"]].head(10)


# Treat zero pages as unavailable or not applicable, as some of these are audiobooks
df_clean["num_pages"] = df_clean["num_pages"].replace(0, float("nan"))
df_clean["num_pages"].isna().sum()


#Checking the remaining page numbers for mistakes
print(df_clean["num_pages"].describe().round(2))
print("\nNegative page counts:", (df_clean["num_pages"] < 0).sum())


#Checking the largest page counts
df_clean[["title", "num_pages", "publisher"]].sort_values("num_pages", ascending=False).head(10)

# Large page counts include collections, boxed sets and reference books.
# Keeping these values because size alone does not indicate an error.


#Checking the smallest page counts
df_clean[["title", "num_pages", "publisher"]].sort_values("num_pages").head(20)


# Inspect unusually small page counts
